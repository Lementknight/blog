{
  "name": "blog",
  "private": true,
  "scripts": {
    "lint:css": "stylelint \"assets/css/extended/**/*.css\"",
    "lint:css:fix": "stylelint \"assets/css/extended/**/*.css\" --fix",
    "lint": "bun run lint:css && bun run lint:md && bun run lint:tags",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "test:a11y": "pa11y-ci && pa11y-ci --config .pa11yci-light.json",
    "prepare": "lefthook install || true",
    "lint:tags": "bash scripts/check-tags.sh"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "pa11y-ci": "^5.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
